@page "/admin/dashboard"
@model AdminDashboardModel

@{
    ViewData["Title"] = "Admin Dashboard";

    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}

<div class="user-dashboard">

    <!-- =========================
         SIDEBAR
         ========================= -->

    <aside class="user-sidebar">

        <!-- BRAND -->

        <div class="user-sidebar-brand">

            <div class="user-brand-icon">
                <i class="fas fa-hospital"></i>
            </div>

            <div>
                <h2>ClinicCare</h2>
                <span>Appointment System</span>
            </div>

        </div>


        <!-- NAVIGATION -->

        <nav class="user-sidebar-nav">

            <div class="user-nav-title">
                MAIN
            </div>


            <a href="/admin/dashboard"
               class="user-nav-link active">

                <i class="fas fa-chart-pie"></i>

                <span>Dashboard</span>

            </a>


            <a href="/appointments"
               class="user-nav-link">

                <i class="fas fa-calendar-check"></i>

                <span>Appointment</span>

            </a>

            <a href="/admin/reports"
               class="user-nav-link">
                <i class="fas fa-file-medical"></i>
                <span>Report</span>
            </a>

            <a href="/admin/doctors"
               class="user-nav-link">

                <i class="fas fa-user-doctor"></i>

                <span>Doctor</span>
            </a>

    
            <div class="user-nav-title">
                MANAGEMENT
            </div>


            <a href="/admin/user-role"
               class="user-nav-link">

                <i class="fas fa-users"></i>

                <span>Manage User</span>

            </a>

            <a href="/account/invite"
               class="user-nav-link">

                <i class="fas fa-user-plus"></i>

                <span>Invite User</span>

            </a>


            <div class="user-nav-title">
                ACCOUNT
            </div>


            <a href="/account/admin-profile"
               class="user-nav-link">

                <i class="fas fa-user"></i>

                <span>Profile</span>

            </a>


            <button type="button"
            class="user-nav-link"
            id="openLogoutModal">

                <i class="fas fa-right-from-bracket"></i>

                <span>Logout</span>

            </button>

        </nav>

    </aside>



    <!-- =========================
         MAIN CONTENT
         ========================= -->

    <main class="user-main">


        <!-- =========================
             TOPBAR
             ========================= -->

        <header class="user-topbar">

            <div class="user-topbar-left">

                <button type="button"
                        class="user-mobile-menu">

                    <i class="fas fa-bars"></i>

                </button>


                <div>

                    <span class="user-page-label">
                        ADMINISTRATION
                    </span>

                    <h1>
                        Dashboard
                    </h1>

                </div>

            </div>


            <div class="user-topbar-right">

                <button type="button"
                        class="user-notification">

                    <i class="far fa-bell"></i>

                    <span></span>

                </button>


                <div class="user-profile-top">

                    <div class="user-top-avatar">
                        <i class="fas fa-user-shield"></i>
                    </div>

                    <div>

                        <strong>
                            @User.Identity?.Name
                        </strong>

                        <span>
                            @role
                        </span>

                    </div>

                </div>

            </div>

        </header>



        <!-- =========================
             DASHBOARD CONTENT
             ========================= -->

        <div class="user-dashboard-content">


            <!-- =========================
                 WELCOME
                 ========================= -->

            <section class="user-welcome">

                <div class="user-welcome-content">

                    <span class="user-welcome-badge">

                        <i class="fas fa-shield-halved"></i>

                        ADMINISTRATOR

                    </span>


                    <h2>
                        Welcome back, Admin!
                    </h2>


                    <p>
                        Manage appointments, doctors, users, and your
                        clinic system from one place.
                    </p>


                    <div class="user-welcome-actions">

                        <a href="/appointments"
                           class="user-primary-button">

                            <i class="fas fa-calendar-check"></i>

                            Manage Appointments

                        </a>


                        <a href="/doctors"
                           class="user-outline-button">

                            <i class="fas fa-user-doctor"></i>

                            View Doctors

                        </a>

                    </div>

                </div>


                <!-- WELCOME DECORATION -->

                <div class="user-welcome-decoration">

                    <div class="user-circle user-circle-one"></div>

                    <div class="user-circle user-circle-two"></div>

                    <i class="fas fa-shield-halved"></i>

                </div>

            </section>



            <!-- =========================
                 STATISTICS
                 ========================= -->

            <section class="user-stat-grid">


                <!-- TOTAL USERS -->

                <div class="user-stat-card">

                    <div class="user-stat-top">

                        <div class="user-stat-icon blue">

                            <i class="fas fa-users"></i>

                        </div>


                        <span class="user-stat-label">
                            USERS
                        </span>

                    </div>


                    <div class="user-stat-info">

                        <span>
                            Total Users
                        </span>

                        <strong>
                            @Model.TotalUsers
                        </strong>

                    </div>


                    <small>
                        Registered clinic users
                    </small>

                </div>



                <!-- TOTAL DOCTORS -->

                <div class="user-stat-card">

                    <div class="user-stat-top">

                        <div class="user-stat-icon purple">

                            <i class="fas fa-user-doctor"></i>

                        </div>


                        <span class="user-stat-label">
                            STAFF
                        </span>

                    </div>


                    <div class="user-stat-info">

                        <span>
                            Total Doctors
                        </span>

                        <strong>
                            @Model.TotalDoctors
                        </strong>

                    </div>


                    <small>
                        Available clinic doctors
                    </small>

                </div>



                <!-- APPOINTMENTS -->

                <div class="user-stat-card">

                    <div class="user-stat-top">

                        <div class="user-stat-icon green">

                            <i class="fas fa-calendar-check"></i>

                        </div>


                        <span class="user-stat-label">
                            TOTAL
                        </span>

                    </div>


                    <div class="user-stat-info">

                        <span>
                            Total Appointments
                        </span>

                        <strong>
                           @Model.TotalAppointments
                        </strong>

                    </div>


                    <small>
                        All recorded appointments
                    </small>

                </div>



                <!-- PENDING -->

                <div class="user-stat-card">

                    <div class="user-stat-top">

                        <div class="user-stat-icon orange">

                            <i class="fas fa-clock"></i>

                        </div>


                        <span class="user-stat-label pending">
                            WAITING
                        </span>

                    </div>


                    <div class="user-stat-info">

                        <span>
                            Pending Appointments
                        </span>

                        <strong>
                            @Model.TotalPendingAppointments
                        </strong>

                    </div>


                    <small>
                        Appointments awaiting approval
                    </small>

                </div>

            </section>

            <!-- =========================
                 RECENT ACTIVITY
                 ========================= -->

            <section class="user-card recent-card">

                <div class="user-card-header">

                    <div>

                        <span>
                            ACTIVITY
                        </span>

                        <h3>
                            Recent Activity
                        </h3>

                    </div>


                    <a href="/appointments">

                        View appointments

                        <i class="fas fa-arrow-right"></i>

                    </a>

                </div>


                <div class="recent-empty">

                    <div>

                        <i class="fas fa-clock-rotate-left"></i>

                    </div>


                    <h4>
                        Recent activity will appear here
                    </h4>


                    <p>
                        Appointment and system activities will appear here
                        as they happen.
                    </p>


                    <a href="/appointments"
                       class="recent-book-button">

                        <i class="fas fa-calendar-check"></i>

                        View Appointments

                    </a>

                </div>


            <!-- =========================
     LOGOUT CONFIRMATION MODAL
========================= -->

<div class="logout-modal-overlay" id="logoutModal">

    <div class="logout-modal-box">

        <div class="logout-modal-icon">
            <i class="fas fa-sign-out-alt"></i>
        </div>

        <h2>Log out?</h2>

        <p>
            Are you sure you want to log out of your account?
        </p>

        <div class="logout-modal-actions">

            <button type="button"
                    class="logout-cancel-btn"
                    id="closeLogoutModal">
                Cancel
            </button>

            <form method="post" asp-page="/Account/Logout">
                @Html.AntiForgeryToken()

                <button type="submit" class="logout-confirm-btn">
                    <i class="fas fa-sign-out-alt"></i>
                    Yes, Log Out
                </button>
            </form>

        </div>

    </div>

</div>
            </section>

        </div>

    </main>

</div>


@section Scripts {

    <script>


    const openLogoutModal = document.getElementById("openLogoutModal");
    const closeLogoutModal = document.getElementById("closeLogoutModal");
    const logoutModal = document.getElementById("logoutModal");

    // OPEN MODAL
    openLogoutModal.addEventListener("click", function () {
        logoutModal.classList.add("show");
    });

    // CLOSE MODAL
    closeLogoutModal.addEventListener("click", function () {
        logoutModal.classList.remove("show");
    });

    // CLOSE WHEN CLICKING OUTSIDE THE BOX
    logoutModal.addEventListener("click", function (event) {
        if (event.target === logoutModal) {
            logoutModal.classList.remove("show");
        }
    });

        document.addEventListener("DOMContentLoaded", function () {

            const menuButton =
                document.querySelector(".user-mobile-menu");

            const sidebar =
                document.querySelector(".user-sidebar");


            if (menuButton && sidebar) {

                menuButton.addEventListener("click", function () {

                    sidebar.classList.toggle("user-sidebar-open");

                });

            }

        });

    </script>

}