
@page "/appointments"
@model AppointmentsModel

@{
    ViewData["Title"] = "Manage Appointments";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}

<div class="user-dashboard">

    <aside class="user-sidebar">
        <div class="user-sidebar-brand">
            <div class="user-brand-icon"><i class="fas fa-hospital"></i></div>
            <div>
                <h2>ClinicCare</h2>
                <span>Appointment System</span>
            </div>
        </div>

        <nav class="user-sidebar-nav">
            <div class="user-nav-title">MAIN</div>

            <a href="/admin/dashboard" class="user-nav-link">
                <i class="fas fa-chart-pie"></i><span>Dashboard</span>
            </a>

            <a href="/appointments" class="user-nav-link active">
                <i class="fas fa-calendar-check"></i><span>Appointment</span>
            </a>

            <a href="/admin/reports"
               class="user-nav-link">
                <i class="fas fa-file-medical"></i>
                <span>Report</span>
            </a>

            <a href="/admin/doctors" class="user-nav-link">
                <i class="fas fa-user-doctor"></i><span>Doctor</span>
            </a>

            <div class="user-nav-title">MANAGEMENT</div>

            <a href="/admin/user-role" class="user-nav-link">
                <i class="fas fa-users"></i><span>Manage User</span>
            </a>

            <a href="/account/invite" class="user-nav-link">
                <i class="fas fa-user-plus"></i><span>Invite User</span>
            </a>

            <div class="user-nav-title">ACCOUNT</div>

            <a href="/account/admin-profile" class="user-nav-link">
                <i class="fas fa-user"></i><span>Profile</span>
            </a>

            <button type="button"
            class="user-nav-link"
            id="openLogoutModal">

                <i class="fas fa-right-from-bracket"></i>

                <span>Logout</span>

            </button>
        </nav>
    </aside>

    <main class="user-main">

        <header class="user-topbar">
            <div class="user-topbar-left">
                <button type="button" class="user-mobile-menu">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <span class="user-page-label">APPOINTMENT MANAGEMENT</span>
                    <h1>Manage Appointments</h1>
                </div>
            </div>

            <div class="user-topbar-right">
                <button type="button" class="user-notification">
                    <i class="far fa-bell"></i><span></span>
                </button>
                <div class="user-profile-top">
                    <div class="user-top-avatar">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <div>
                        <strong>@User.Identity?.Name</strong>
                        <span>@role</span>
                    </div>
                </div>
            </div>
        </header>

        <div class="user-dashboard-content appointment-content">

            <section class="doctor-page-header">
                <div class="doctor-header-info">
                    <div class="doctor-page-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div>
                        <span>APPOINTMENT MANAGEMENT</span>
                        <h2>Manage Appointments</h2>
                        <p>View appointments, update their status, and manage patient information.</p>
                    </div>
                </div>
            </section>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <strong>Success!</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Error!</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <section class="user-card doctor-card">

                <div class="doctor-card-header">
                    <div class="doctor-title">
                        <div class="doctor-title-icon">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <div>
                            <h3>Registered Appointments</h3>
                            <p>View and manage patient appointments.</p>
                        </div>
                    </div>

                    <div class="appointment-card-actions">
                        <span class="appointment-count">
                            <i class="fas fa-calendar-check"></i>
                            @Model.TotalRecords Appointments
                        </span>

                        <button type="button"
                                class="appointment-add-button"
                                data-bs-toggle="modal"
                                data-bs-target="#addAppointmentModal">
                            <i class="fas fa-plus"></i> Add Appointment
                        </button>
                    </div>
                </div>

                <div class="doctor-search-area">
                    <form method="get" action="/appointments" class="doctor-search-form">
                        <div class="doctor-search-input">
                            <i class="fas fa-magnifying-glass"></i>
                            <input type="text"
                                   id="appointmentSearch"
                                   name="keyword"
                                   value="@Model.Keyword"
                                   placeholder="Search appointments..."
                                   autocomplete="off" />
                        </div>
                        <button type="submit" class="doctor-search-button">
                            <i class="fas fa-magnifying-glass"></i> Search
                        </button>
                    </form>
                </div>

                @if (Model.Appointments.Count == 0)
                {
                    <div class="doctor-empty">
                        <div class="doctor-empty-icon">
                            <i class="fas fa-calendar-xmark"></i>
                        </div>
                        <h4>No appointments found</h4>
                        <p>There are currently no appointments matching your search.</p>
                    </div>
                }
                else
                {
                    <div class="appointment-grid">
                        @foreach (var appointment in Model.Appointments)
                        {
                            var currentStatus =
                                string.IsNullOrWhiteSpace(appointment.Status)
                                    ? "Pending"
                                    : appointment.Status;

                            var statusClass = currentStatus.ToLowerInvariant() switch
                            {
                                "pending" => "status-pending",
                                "confirmed" => "status-confirmed",
                                "completed" => "status-completed",
                                "cancelled" => "status-cancelled",
                                _ => "status-pending"
                            };

                            <div class="appointment-grid-card"
                                 tabindex="0"
                                 role="button"
                                 data-bs-toggle="modal"
                                 data-bs-target="#appointmentDetailsModal"
                                 data-id="@appointment.Id"
                                 data-patient="@appointment.Patient"
                                 data-patient-code="@appointment.PatientCode"
                                 data-doctor="@appointment.Doctor"
                                 data-date="@appointment.Date.ToString("MMM dd, yyyy")"
                                 data-time="@DateTime.Today.Add(appointment.Time).ToString("hh:mm tt")"
                                 data-status="@currentStatus"
                                 data-status-class="@statusClass"
                                 data-contact="@appointment.ContactInfo"
                                 data-notes="@appointment.Notes">

                                <div class="appointment-card-top">
                                    <div class="appointment-card-patient">
                                        <div class="appointment-card-avatar">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div class="appointment-card-patient-info">
                                            <h4>@appointment.Patient</h4>
                                            <span>Patient #@appointment.PatientCode</span>
                                        </div>
                                    </div>

                                    <span class="appointment-status @statusClass">
                                        @currentStatus
                                    </span>
                                </div>

                                <div class="appointment-card-details">
                                    <div class="appointment-card-detail">
                                        <div class="appointment-detail-icon">
                                            <i class="fas fa-user-doctor"></i>
                                        </div>
                                        <div>
                                            <span class="appointment-detail-label">Doctor</span>
                                            <strong>@appointment.Doctor</strong>
                                        </div>
                                    </div>

                                    <div class="appointment-card-detail">
                                        <div class="appointment-detail-icon">
                                            <i class="fas fa-calendar-days"></i>
                                        </div>
                                        <div>
                                            <span class="appointment-detail-label">Date &amp; Time</span>
                                            <strong>
                                                @appointment.Date.ToString("MMM dd, yyyy")
                                                ·
                                                @DateTime.Today.Add(appointment.Time).ToString("hh:mm tt")
                                            </strong>
                                        </div>
                                    </div>
                                </div>

                                <div class="appointment-card-footer">
                                    <span>
                                        <i class="fas fa-arrow-up-right-from-square"></i>
                                        View appointment details
                                    </span>
                                    <i class="fas fa-chevron-right"></i>
                                </div>
                            </div>
                        }
                    </div>

                    var safeKeyword = Uri.EscapeDataString(Model.Keyword ?? "");

                    @if (Model.TotalPages > 1)
                    {
                        <div class="user-role-pagination-container">
                            <nav aria-label="Appointment pagination">
                                <ul class="pagination user-role-pagination">

                                    <!-- FIRST -->
                                    <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                                        @if (Model.PageIndex <= 1)
                                        {
                                            <span class="page-link">First</span>
                                        }
                                        else
                                        {
                                            <a class="page-link"
                                            href="/appointments?pageIndex=1&amp;keyword=@safeKeyword">
                                                First
                                            </a>
                                        }
                                    </li>

                                    <!-- PREVIOUS -->
                                    <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                                        @if (Model.PageIndex <= 1)
                                        {
                                            <span class="page-link">&laquo;</span>
                                        }
                                        else
                                        {
                                            <a class="page-link"
                                            href="/appointments?pageIndex=@(Model.PageIndex - 1)&amp;keyword=@safeKeyword">
                                                &laquo;
                                            </a>
                                        }
                                    </li>

                                    <!-- CURRENT PAGE -->
                                    <li class="page-item active">
                                        <span class="page-link">
                                            @Model.PageIndex of @Model.TotalPages
                                        </span>
                                    </li>

                                    <!-- NEXT -->
                                    <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                                        @if (Model.PageIndex >= Model.TotalPages)
                                        {
                                            <span class="page-link">&raquo;</span>
                                        }
                                        else
                                        {
                                            <a class="page-link"
                                            href="/appointments?pageIndex=@(Model.PageIndex + 1)&amp;keyword=@safeKeyword">
                                                &raquo;
                                            </a>
                                        }
                                    </li>

                                    <!-- LAST -->
                                    <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                                        @if (Model.PageIndex >= Model.TotalPages)
                                        {
                                            <span class="page-link">Last</span>
                                        }
                                        else
                                        {
                                            <a class="page-link"
                                            href="/appointments?pageIndex=@Model.TotalPages&amp;keyword=@safeKeyword">
                                                Last
                                            </a>
                                        }
                                    </li>

                                </ul>
                            </nav>
                        </div>
                    }
                }
            </section>
        </div>
    </main>
</div>

<!-- =========================================================
     APPOINTMENT DETAILS AND STATUS ACTIONS MODAL
========================================================= -->

<div class="modal fade"
     id="appointmentDetailsModal"
     tabindex="-1"
     aria-labelledby="appointmentDetailsTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content appointment-details-modal">

            <div class="appointment-details-header">
                <div class="appointment-details-title">
                    <div class="appointment-details-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div>
                        <span>APPOINTMENT DETAILS</span>
                        <h4 id="appointmentDetailsTitle">Patient</h4>
                    </div>
                </div>

                <button type="button"
                        class="appointment-details-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>

            <div class="appointment-details-body">

                <div class="appointment-details-status-row">
                    <span class="details-label">Appointment Status</span>
                    <span id="modalStatus" class="appointment-status status-pending">
                        Pending
                    </span>
                </div>

                <div class="appointment-details-grid">
                    <div class="appointment-detail-box">
                        <div class="appointment-detail-box-icon">
                            <i class="fas fa-user"></i>
                        </div>
                        <div>
                            <span>Patient Name</span>
                            <strong id="modalPatient">—</strong>
                        </div>
                    </div>

                    <div class="appointment-detail-box">
                        <div class="appointment-detail-box-icon">
                            <i class="fas fa-hashtag"></i>
                        </div>
                        <div>
                            <span>Patient Code</span>
                            <strong id="modalPatientCode">—</strong>
                        </div>
                    </div>

                    <div class="appointment-detail-box">
                        <div class="appointment-detail-box-icon">
                            <i class="fas fa-user-doctor"></i>
                        </div>
                        <div>
                            <span>Doctor</span>
                            <strong id="modalDoctor">—</strong>
                        </div>
                    </div>

                    <div class="appointment-detail-box">
                        <div class="appointment-detail-box-icon">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div>
                            <span>Contact Information</span>
                            <strong id="modalContact">—</strong>
                        </div>
                    </div>

                    <div class="appointment-detail-box">
                        <div class="appointment-detail-box-icon">
                            <i class="fas fa-calendar"></i>
                        </div>
                        <div>
                            <span>Appointment Date</span>
                            <strong id="modalDate">—</strong>
                        </div>
                    </div>

                    <div class="appointment-detail-box">
                        <div class="appointment-detail-box-icon">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div>
                            <span>Appointment Time</span>
                            <strong id="modalTime">—</strong>
                        </div>
                    </div>
                </div>

                <div class="appointment-details-notes">
                    <div class="appointment-notes-heading">
                        <div class="appointment-notes-icon">
                            <i class="fas fa-note-sticky"></i>
                        </div>
                        <div>
                            <span>Appointment Notes</span>
                            <strong>Additional Information</strong>
                        </div>
                    </div>
                    <p id="modalNotes">No notes available.</p>
                </div>

            </div>

            <!-- STATUS ACTIONS -->
            <div class="appointment-details-footer"
                 style="display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end;">

                <button type="button"
                        class="appointment-details-close-button"
                        data-bs-dismiss="modal">
                    Close
                </button>

                <form method="post" asp-page-handler="Confirm" id="confirmAppointmentForm">
                    <input type="hidden" name="id" id="confirmAppointmentId" />
                    <input type="hidden" name="pageIndex" value="@Model.PageIndex" />
                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                    <button type="submit" class="appointment-save-button">
                        <i class="fas fa-check"></i> Confirm
                    </button>
                </form>

                <form method="post" asp-page-handler="Complete" id="completeAppointmentForm">
                    <input type="hidden" name="id" id="completeAppointmentId" />
                    <input type="hidden" name="pageIndex" value="@Model.PageIndex" />
                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                    <button type="submit" class="appointment-save-button">
                        <i class="fas fa-check"></i> Complete
                    </button>
                </form>

                <form method="post" asp-page-handler="Cancel" id="cancelAppointmentForm">
                    <input type="hidden" name="id" id="cancelAppointmentId" />
                    <input type="hidden" name="pageIndex" value="@Model.PageIndex" />
                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                    <button type="submit"
                            class="appointment-cancel-button"
                            onclick="return confirm('Are you sure you want to cancel this appointment?');">
                        <i class="fas fa-xmark"></i> Cancel Appointment
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>

<!-- =========================================================
     ADD APPOINTMENT MODAL
========================================================= -->

<div class="modal fade"
     id="addAppointmentModal"
     tabindex="-1"
     aria-labelledby="addAppointmentModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content appointment-modal">

            <div class="appointment-modal-header">
                <div class="appointment-modal-title">
                    <div class="appointment-modal-icon">
                        <i class="fas fa-calendar-plus"></i>
                    </div>
                    <div>
                        <h4 id="addAppointmentModalLabel">Add New Appointment</h4>
                        <p>Enter the appointment details below.</p>
                    </div>
                </div>

                <button type="button"
                        class="appointment-modal-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>

            <form method="post" asp-page-handler="AddAppointment">
                <div class="appointment-modal-body">

                    <div asp-validation-summary="ModelOnly"
                         class="appointment-form-error mb-3"></div>

                    <div class="appointment-form-group">
                        <label asp-for="Input.PatientCode">
                            <i class="fas fa-hashtag"></i> Patient Code
                        </label>
                        <input asp-for="Input.PatientCode"
                               type="number"
                               class="appointment-form-input"
                               placeholder="Example: 1009" />
                        <span asp-validation-for="Input.PatientCode"
                              class="appointment-form-error"></span>
                    </div>

                    <div class="appointment-form-group">
                        <label asp-for="Input.Patient">
                            <i class="fas fa-user"></i> Patient Name
                        </label>
                        <input asp-for="Input.Patient"
                               class="appointment-form-input"
                               placeholder="Enter patient's name" />
                        <span asp-validation-for="Input.Patient"
                              class="appointment-form-error"></span>
                    </div>

                    <div class="appointment-form-group">
                        <label asp-for="Input.ContactInfo">
                            <i class="fas fa-phone"></i> Contact Number
                        </label>
                        <input asp-for="Input.ContactInfo"
                               class="appointment-form-input"
                               placeholder="Enter contact number" />
                        <span asp-validation-for="Input.ContactInfo"
                              class="appointment-form-error"></span>
                    </div>

                    <div class="appointment-form-group">
                        <label asp-for="Input.Doctor">
                            <i class="fas fa-user-doctor"></i> Doctor
                        </label>
                        <input asp-for="Input.Doctor"
                               class="appointment-form-input"
                               placeholder="Enter doctor's name" />
                        <span asp-validation-for="Input.Doctor"
                              class="appointment-form-error"></span>
                    </div>

                    <div class="appointment-form-row">
                        <div class="appointment-form-group">
                            <label asp-for="Input.Date">
                                <i class="fas fa-calendar"></i> Appointment Date
                            </label>
                            <input asp-for="Input.Date"
                                   type="date"
                                   class="appointment-form-input"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="Input.Date"
                                  class="appointment-form-error"></span>
                        </div>

                        <div class="appointment-form-group">
                            <label asp-for="Input.Time">
                                <i class="fas fa-clock"></i> Appointment Time
                            </label>
                            <input asp-for="Input.Time"
                                   type="time"
                                   class="appointment-form-input" />
                            <span asp-validation-for="Input.Time"
                                  class="appointment-form-error"></span>
                        </div>
                    </div>

                    <div class="appointment-form-group">
                        <label asp-for="Input.Notes">
                            <i class="fas fa-note-sticky"></i> Notes
                        </label>
                        <textarea asp-for="Input.Notes"
                                  class="appointment-form-textarea"
                                  rows="4"
                                  placeholder="Enter appointment notes (optional)"></textarea>
                        <span asp-validation-for="Input.Notes"
                              class="appointment-form-error"></span>
                    </div>

                </div>

                <div class="appointment-modal-footer">
                    <button type="button"
                            class="appointment-cancel-button"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="appointment-save-button">
                        <i class="fas fa-calendar-plus"></i> Add Appointment
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- =========================
     LOGOUT CONFIRMATION MODAL
========================= -->

<div class="logout-modal-overlay" id="logoutModal">

    <div class="logout-modal-box">

        <div class="logout-modal-icon">
            <i class="fas fa-sign-out-alt"></i>
        </div>

        <h2>Log out?</h2>

        <p>
            Are you sure you want to log out of your account?
        </p>

        <div class="logout-modal-actions">

            <button type="button"
                    class="logout-cancel-btn"
                    id="closeLogoutModal">
                Cancel
            </button>

            <form method="post" asp-page="/Account/Logout">
                @Html.AntiForgeryToken()

                <button type="submit" class="logout-confirm-btn">
                    <i class="fas fa-sign-out-alt"></i>
                    Yes, Log Out
                </button>
            </form>

        </div>

    </div>

</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>



    const openLogoutModal = document.getElementById("openLogoutModal");
    const closeLogoutModal = document.getElementById("closeLogoutModal");
    const logoutModal = document.getElementById("logoutModal");

    // OPEN MODAL
    openLogoutModal.addEventListener("click", function () {
        logoutModal.classList.add("show");
    });

    // CLOSE MODAL
    closeLogoutModal.addEventListener("click", function () {
        logoutModal.classList.remove("show");
    });

    // CLOSE WHEN CLICKING OUTSIDE THE BOX
    logoutModal.addEventListener("click", function (event) {
        if (event.target === logoutModal) {
            logoutModal.classList.remove("show");
        }
    });

        document.addEventListener("DOMContentLoaded", function () {

            // Mobile sidebar
            const menuButton = document.querySelector(".user-mobile-menu");
            const sidebar = document.querySelector(".user-sidebar");

            if (menuButton && sidebar) {
                menuButton.addEventListener("click", function () {
                    sidebar.classList.toggle("user-sidebar-open");
                });
            }

            // Search
            const searchInput = document.getElementById("appointmentSearch");
            let searchTimer;

            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    clearTimeout(searchTimer);

                    const keyword = this.value.trim();

                    searchTimer = setTimeout(function () {
                        window.location.href =
                            "/appointments?keyword=" +
                            encodeURIComponent(keyword);
                    }, 600);
                });
            }

            // Appointment details and action buttons
            const cards = document.querySelectorAll(".appointment-grid-card");

            const modalPatientName = document.getElementById("appointmentDetailsTitle");
            const modalPatient = document.getElementById("modalPatient");
            const modalPatientCode = document.getElementById("modalPatientCode");
            const modalDoctor = document.getElementById("modalDoctor");
            const modalContact = document.getElementById("modalContact");
            const modalDate = document.getElementById("modalDate");
            const modalTime = document.getElementById("modalTime");
            const modalStatus = document.getElementById("modalStatus");
            const modalNotes = document.getElementById("modalNotes");

            const confirmForm = document.getElementById("confirmAppointmentForm");
            const completeForm = document.getElementById("completeAppointmentForm");
            const cancelForm = document.getElementById("cancelAppointmentForm");

            function setFormAppointmentId(form, inputId, id) {
                document.getElementById(inputId).value = id;
                form.querySelector("button[type='submit']").disabled = false;
            }

            function loadAppointmentDetails(card) {
                const patient = card.dataset.patient || "—";
                const status = card.dataset.status || "Pending";
                const statusLower = status.toLowerCase();

                modalPatientName.textContent = patient;
                modalPatient.textContent = patient;
                modalPatientCode.textContent = card.dataset.patientCode || "—";
                modalDoctor.textContent = card.dataset.doctor || "—";
                modalContact.textContent = card.dataset.contact || "—";
                modalDate.textContent = card.dataset.date || "—";
                modalTime.textContent = card.dataset.time || "—";
                modalNotes.textContent = card.dataset.notes || "No notes available.";

                modalStatus.textContent = status;
                modalStatus.className =
                    "appointment-status " +
                    (card.dataset.statusClass || "status-pending");

                const id = card.dataset.id;

                setFormAppointmentId(confirmForm, "confirmAppointmentId", id);
                setFormAppointmentId(completeForm, "completeAppointmentId", id);
                setFormAppointmentId(cancelForm, "cancelAppointmentId", id);

                // Only Pending appointments can be confirmed.
                confirmForm.hidden = !(
                    statusLower === "pending" ||
                    statusLower === ""
                );

                // Only Confirmed appointments can be completed.
                completeForm.hidden = statusLower !== "confirmed";

                // Pending or Confirmed appointments can be cancelled.
                cancelForm.hidden = !(
                    statusLower === "pending" ||
                    statusLower === "" ||
                    statusLower === "confirmed"
                );
            }

            cards.forEach(function (card) {
                card.addEventListener("click", function () {
                    loadAppointmentDetails(card);
                });

                card.addEventListener("keydown", function (event) {
                    if (event.key === "Enter" || event.key === " ") {
                        event.preventDefault();
                        loadAppointmentDetails(card);

                        const modalElement =
                            document.getElementById("appointmentDetailsModal");

                        bootstrap.Modal.getOrCreateInstance(modalElement).show();
                    }
                });
            });

            // Reopen Add Appointment modal if validation fails.
            const showAddAppointmentModal =
                @((!ViewData.ModelState.IsValid).ToString().ToLower());

            if (showAddAppointmentModal &&
                typeof bootstrap !== "undefined") {

                const addModalElement =
                    document.getElementById("addAppointmentModal");

                if (addModalElement) {
                    bootstrap.Modal
                        .getOrCreateInstance(addModalElement)
                        .show();
                }
            }
        });
    </script>
}
