@page "/account/change-password"
@model ChangePassword

<form method="post" class="mt-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="card shadow" style="border-radius:15px;">
                    <div class="card-body p-5">
                        <div class="row align-items-center">
                            <div class="col-md-4 text-center">
                                <img src="@Model.ChangePasswordDto.ProfileImage"
                                     class="img-fluid rounded shadow"
                                     style="width:200px;height:200px;object-fit:cover;"
                                     alt="@Model.ChangePasswordDto.Username">
                            </div>
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label class="form-label">Email Address</label>
                                    <p class="card-text">@Model.ChangePasswordDto.Username</p>
                                </div>
                                <div class="mb-3">
                                    <label for="currentPassword" class="form-label">Current Password</label>
                                    <input type="password"
                                           class="form-control"
                                           id="currentPassword"
                                           asp-for="@Model.ChangePasswordDto.CurrentPassword">
                                    <span asp-validation-for="@Model.ChangePasswordDto.CurrentPassword"
                                          class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label for="newPassword" class="form-label">New Password</label>
                                    <input type="password"
                                           class="form-control"
                                           id="newPassword"
                                           asp-for="@Model.ChangePasswordDto.NewPassword">
                                    <span asp-validation-for="@Model.ChangePasswordDto.NewPassword"
                                          class="text-danger"></span>
                                </div>
                                <div class="mb-4">
                                    <label for="confirmPassword" class="form-label">Confirm New Password</label>
                                    <input type="password"
                                           class="form-control"
                                           id="confirmPassword"
                                           asp-for="@Model.ChangePasswordDto.ConfirmNewPassword">
                                    <span asp-validation-for="@Model.ChangePasswordDto.ConfirmNewPassword"
                                          class="text-danger"></span>
                                </div>
                                <button type="submit" class="btn btn-primary">
                                    Submit
                                </button>
                                <button type="button"
                                        class="btn btn-danger"
                                        onclick="window.location.href='/account/profile'">
                                    Return
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>