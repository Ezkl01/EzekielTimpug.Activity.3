@page "/account/change-password"
@model ChangePassword

@{
    ViewData["Title"] = "Change Password";
}

@{
    var profileUrl = User.IsInRole("Admin")
        ? "/account/admin-profile"
        : "/account/user-profile";
}

<div class="account-page">

    <!-- =========================
         CLINICCARE BRAND
         ========================= -->

    <div class="account-page-brand">

        <div class="account-brand-icon">
            <i class="fas fa-hospital"></i>
        </div>

        <div class="account-brand-text">
            <h2>ClinicCare</h2>
            <span>Appointment System</span>
        </div>

    </div>


    <!-- =========================
         MAIN CARD
         ========================= -->

    <div class="account-card">

        <!-- =========================
             HEADER
             ========================= -->

        <div class="account-card-header">

            <div class="account-header-icon">
                <i class="fas fa-key"></i>
            </div>

            <div>

                <span class="account-header-label">
                    ACCOUNT SECURITY
                </span>

                <h1>
                    Change Password
                </h1>

                <p>
                    Update your password to keep your account secure.
                </p>

            </div>

        </div>


        <!-- =========================
             BODY
             ========================= -->

        <div class="account-card-body">


            <!-- =========================
                 PROFILE PREVIEW
                 ========================= -->

            <div class="profile-preview-section">

                <div class="profile-image-wrapper">

                    <img src="@(string.IsNullOrEmpty(Model.ChangePasswordDto.ProfileImage)
                        ? "/users/default.png"
                        : Model.ChangePasswordDto.ProfileImage)"
                         alt="@Model.ChangePasswordDto.Username"
                         class="profile-preview-image" />

                </div>


                <div class="profile-preview-info">

                    <h2>
                        @Model.ChangePasswordDto.Username
                    </h2>

                    <p>
                        Update your password to keep your ClinicCare account secure.
                    </p>

                </div>

            </div>


            <div class="account-divider"></div>


            <!-- =========================
                 PASSWORD INFORMATION
                 ========================= -->

            <div class="account-section-heading">

                <div class="account-section-icon green">
                    <i class="fas fa-lock"></i>
                </div>

                <div>

                    <h2>
                        Password Information
                    </h2>

                    <p>
                        Enter your current password and choose a new secure password.
                    </p>

                </div>

            </div>


            <!-- =========================
                 CHANGE PASSWORD FORM
                 ========================= -->

            <form method="post" class="account-form">


                <!-- =========================
                     EMAIL ADDRESS
                     ========================= -->

                <div class="account-form-group full-width">

                    <label>
                        <i class="fas fa-envelope"></i>
                        Email Address
                    </label>

                    <div class="account-readonly-input">

                        <i class="fas fa-envelope"></i>

                        <span>
                            @Model.ChangePasswordDto.Username
                        </span>

                    </div>

                </div>


                <!-- =========================
                     CURRENT PASSWORD
                     ========================= -->

                <div class="account-form-group full-width">

                    <label asp-for="ChangePasswordDto.CurrentPassword">

                        <i class="fas fa-lock"></i>
                        Current Password

                    </label>

                    <input type="password"
                           asp-for="ChangePasswordDto.CurrentPassword"
                           class="account-input"
                           placeholder="Enter your current password" />

                    <span asp-validation-for="ChangePasswordDto.CurrentPassword"
                          class="account-validation">
                    </span>

                </div>


                <!-- =========================
                     NEW + CONFIRM PASSWORD
                     ========================= -->

                <div class="account-form-row">


                    <!-- NEW PASSWORD -->

                    <div class="account-form-group">

                        <label asp-for="ChangePasswordDto.NewPassword">

                            <i class="fas fa-key"></i>
                            New Password

                        </label>

                        <input type="password"
                               asp-for="ChangePasswordDto.NewPassword"
                               class="account-input"
                               placeholder="Enter your new password" />

                        <span asp-validation-for="ChangePasswordDto.NewPassword"
                              class="account-validation">
                        </span>

                    </div>


                    <!-- CONFIRM PASSWORD -->

                    <div class="account-form-group">

                        <label asp-for="ChangePasswordDto.ConfirmNewPassword">

                            <i class="fas fa-shield-alt"></i>
                            Confirm New Password

                        </label>

                        <input type="password"
                               asp-for="ChangePasswordDto.ConfirmNewPassword"
                               class="account-input"
                               placeholder="Confirm your new password" />

                        <span asp-validation-for="ChangePasswordDto.ConfirmNewPassword"
                              class="account-validation">
                        </span>

                    </div>

                </div>


                <!-- =========================
                     VALIDATION SUMMARY
                     ========================= -->

                <div class="account-validation-summary">

                    <div asp-validation-summary="All"></div>

                </div>


                <!-- =========================
                     FORM ACTIONS
                     ========================= -->

                <div class="account-form-actions">

                    <button type="submit"
                            class="account-save-button">

                        <i class="fas fa-check"></i>
                        Update Password

                    </button>


                    <button type="button"
                            class="account-cancel-button"
                            onclick="window.location.href='@profileUrl'">

                        <i class="fas fa-arrow-left"></i>
                        Return to Profile

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}