@page "/account/forgot-password"
@model ForgotPassword

<form method="post" class="mt-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card shadow" style="border-radius:15px;">
                    <div class="card-body p-5">

                        <div class="row align-items-center">
                            <div class="col-md-15">
                              @if (!string.IsNullOrEmpty(Model.SuccessMessage)) { <div class="alert alert-success" role="alert"> @Model.SuccessMessage </div> }
                                <label for="exampleInputEmail1" class="form-label">
                                    Email address
                                </label>
                                <input type="email"
                                       class="form-control"
                                       id="exampleInputEmail1"
                                       aria-describedby="emailHelp"
                                       asp-for="@Model.ForgotPasswordDto.Username">

                                <span asp-validation-for="@Model.ForgotPasswordDto.Username"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Buttons -->
                       <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Submit
                            </button>

                            <button type="button"
                                    class="btn btn-danger px-4"
                                    onclick="window.location.href='/account/login'">
                                Return
                            </button>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
