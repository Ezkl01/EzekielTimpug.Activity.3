@page "/account/invite"
@model Invite

@{
ViewData["Title"] = "Invite User";

var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

}

<div class="user-dashboard">

<!--SIDEBAR -->

<aside class="user-sidebar">

    <!-- BRAND -->

    <div class="user-sidebar-brand">

        <div class="user-brand-icon">
            <i class="fas fa-hospital"></i>
        </div>

        <div>
            <h2>ClinicCare</h2>
            <span>Appointment System</span>
        </div>

    </div>


    <!-- NAVIGATION -->

    <nav class="user-sidebar-nav">

        <div class="user-nav-title">
            MAIN
        </div>

        <a href="/admin/dashboard"
           class="user-nav-link">

            <i class="fas fa-chart-pie"></i>

            <span>Dashboard</span>

        </a>


        <a href="/appointments"
           class="user-nav-link">

            <i class="fas fa-calendar-check"></i>

            <span>Appointment</span>

        </a>


         <a href="/admin/reports"
               class="user-nav-link">
                <i class="fas fa-file-medical"></i>
                <span>Report</span>
            </a>
            
        <a href="/admin/doctors"
           class="user-nav-link">

            <i class="fas fa-user-doctor"></i>

            <span>Doctor</span>

        </a>


        <div class="user-nav-title">
            MANAGEMENT
        </div>


        <a href="/admin/user-role"
           class="user-nav-link">

            <i class="fas fa-users"></i>

            <span>Manage User</span>

        </a>


        <a href="/account/invite"
           class="user-nav-link active">

            <i class="fas fa-user-plus"></i>

            <span>Invite User</span>

        </a>


        <div class="user-nav-title">
            ACCOUNT
        </div>


        <a href="/account/admin-profile"
           class="user-nav-link">

            <i class="fas fa-user"></i>

            <span>Profile</span>

        </a>


        <button type="button"
            class="user-nav-link"
            id="openLogoutModal">

                <i class="fas fa-right-from-bracket"></i>

                <span>Logout</span>

            </button>

    </nav>
</aside>



<!--
     MAIN CONTENT -->

<main class="user-main">


    <!-- TOPBAR -->

    <header class="user-topbar">

        <div class="user-topbar-left">

            <button type="button"
                    class="user-mobile-menu">

                <i class="fas fa-bars"></i>

            </button>


            <div>

                <span class="user-page-label">
                    ADMINISTRATION
                </span>

                <h1>
                    Invite User
                </h1>

            </div>

        </div>


        <div class="user-topbar-right">

            <button type="button"
                    class="user-notification">

                <i class="far fa-bell"></i>

                <span></span>

            </button>


            <div class="user-profile-top">

                <div class="user-top-avatar">
                    <i class="fas fa-user-shield"></i>
                </div>

                <div>

                    <strong>
                        @User.Identity?.Name
                    </strong>

                    <span>
                        @role
                    </span>

                </div>

            </div>

        </div>

    </header>



    <!--INVITE CONTENT-->

    <div class="user-dashboard-content invite-page-content">


        <!-- PAGE HEADER -->

        <section class="invite-page-header">

            <div class="invite-header-info">

                <div class="invite-page-icon">

                    <i class="fas fa-user-plus"></i>

                </div>


                <div>

                    <span>
                        USER MANAGEMENT
                    </span>

                    <h2>
                        Invite New User
                    </h2>

                    <p>
                        Create an invitation for a new user to join the ClinicCare Appointment System.
                    </p>

                </div>

            </div>

        </section>



        <!--INVITE CARD-->

        <section class="invite-card">


            <!-- CARD HEADER -->

            <div class="invite-card-header">

                <div>

                    <h3>
                        User Information
                    </h3>

                    <p>
                        Enter the information of the person you want to invite.
                    </p>

                </div>


                <div class="invite-card-icon">

                    <i class="fas fa-envelope"></i>

                </div>

            </div>



            <!-- FORM -->

            <form method="post"
                  class="invite-form">


                <div asp-validation-summary="All"
                     class="invite-validation">
                </div>


                <!-- EMAIL -->

                <div class="invite-form-group">

                    <label asp-for="UserInviteDto.UserName">

                        <i class="fas fa-envelope"></i>

                        Email Address

                    </label>


                    <input type="email"
                           class="invite-input"
                           asp-for="UserInviteDto.UserName"
                           placeholder="Enter email address" />


                    <span asp-validation-for="UserInviteDto.UserName"
                          class="invite-error">
                    </span>

                </div>



                <!-- NAME ROW -->

                <div class="invite-form-row">


                    <!-- FIRST NAME -->

                    <div class="invite-form-group">

                        <label asp-for="UserInviteDto.FirstName">

                            <i class="fas fa-user"></i>

                            First Name

                        </label>


                        <input type="text"
                               class="invite-input"
                               asp-for="UserInviteDto.FirstName"
                               placeholder="Enter first name" />


                        <span asp-validation-for="UserInviteDto.FirstName"
                              class="invite-error">
                        </span>

                    </div>



                    <!-- LAST NAME -->

                    <div class="invite-form-group">

                        <label asp-for="UserInviteDto.LastName">

                            <i class="fas fa-user"></i>

                            Last Name

                        </label>


                        <input type="text"
                               class="invite-input"
                               asp-for="UserInviteDto.LastName"
                               placeholder="Enter last name" />


                        <span asp-validation-for="UserInviteDto.LastName"
                              class="invite-error">
                        </span>

                    </div>

                </div>



                <!-- DATE OF BIRTH -->

                <div class="invite-form-group">

                    <label asp-for="UserInviteDto.DateOfBirth">

                        <i class="fas fa-calendar"></i>

                        Date of Birth

                    </label>


                    <input type="date"
                           class="invite-input"
                           asp-for="UserInviteDto.DateOfBirth" />


                    <span asp-validation-for="UserInviteDto.DateOfBirth"
                          class="invite-error">
                    </span>

                </div>



                <!-- ACTIONS -->

                <div class="invite-form-actions">


                    <button type="button"
                            class="invite-cancel-button"
                            onclick="window.location.href='/admin/user-role'">

                        <i class="fas fa-arrow-left"></i>

                        Cancel

                    </button>


                    <button type="submit"
                            class="invite-submit-button">

                        <i class="fas fa-paper-plane"></i>

                        Send Invitation

                    </button>

                </div>


            </form>

        </section>

         <!--
                    LOGOUT CONFIRMATION MODAL
             -->

                <div class="logout-modal-overlay" id="logoutModal">

                    <div class="logout-modal-box">

                        <div class="logout-modal-icon">
                            <i class="fas fa-sign-out-alt"></i>
                        </div>

                        <h2>Log out?</h2>

                        <p>
                            Are you sure you want to log out of your account?
                        </p>

                        <div class="logout-modal-actions">

                            <button type="button"
                                    class="logout-cancel-btn"
                                    id="closeLogoutModal">
                                Cancel
                            </button>

                            <form method="post" asp-page="/Account/Logout">
                                @Html.AntiForgeryToken()

                                <button type="submit" class="logout-confirm-btn">
                                    <i class="fas fa-sign-out-alt"></i>
                                    Yes, Log Out
                                </button>
                            </form>

                        </div>

                    </div>

                </div>

    </div>

</main>

</div>

@section Scripts {

<partial name="_ValidationScriptsPartial" />

<script>

    const openLogoutModal = document.getElementById("openLogoutModal");
    const closeLogoutModal = document.getElementById("closeLogoutModal");
    const logoutModal = document.getElementById("logoutModal");

    // OPEN MODAL
    openLogoutModal.addEventListener("click", function () {
        logoutModal.classList.add("show");
    });

    // CLOSE MODAL
    closeLogoutModal.addEventListener("click", function () {
        logoutModal.classList.remove("show");
    });

    // CLOSE WHEN CLICKING OUTSIDE THE BOX
    logoutModal.addEventListener("click", function (event) {
        if (event.target === logoutModal) {
            logoutModal.classList.remove("show");
        }
    });

    document.addEventListener("DOMContentLoaded", function () {

        const menuButton =
            document.querySelector(".user-mobile-menu");

        const sidebar =
            document.querySelector(".user-sidebar");


        if (menuButton && sidebar) {

            menuButton.addEventListener("click", function () {

                sidebar.classList.toggle("user-sidebar-open");

            });

        }

    });

</script>

}
