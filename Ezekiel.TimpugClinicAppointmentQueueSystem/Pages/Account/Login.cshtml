@page "/account/login"
@model Login


<form method="post">
    <section class="vh-100">
        <div class="container-fluid h-100">
            <div class="row h-100">

                <!-- Left Side -->
                <div class="col-lg-6 d-flex flex-column justify-content-center px-5">

                    <div class="mb-5">
                        <span class="bi bi-bandaid-fill display-5 fw-bold">ClinicAppointment</span>
                    </div>

                    <div style="max-width:420px; width:100%;">

                        <h2 class="fw-normal mb-4">Log in</h2>

                        <div class="form-floating mb-3">
                            <input asp-for="@Model.UserLoginDto.UserName"
                                   type="email"
                                   class="form-control"
                                   placeholder="Email Address" />
                            <label asp-for="@Model.UserLoginDto.UserName">Email Address</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="@Model.UserLoginDto.Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Password" />
                            <label asp-for="@Model.UserLoginDto.Password">Password</label>
                        </div>
                            @if (ViewData.ModelState[string.Empty]?.Errors.Any() == true)
                                {
                                    <div class="login-error mt-2">
                                        @ViewData.ModelState[string.Empty]!.Errors.First().ErrorMessage
                                    </div>
                                }
                        <button type="submit" class="btn btn-info btn-lg w-100">
                            Login
                        </button>

                        @*<div asp-validation-summary="All" class="text-danger text-center mb-2"></div>*@

                        <div class="mt-4">
                            <a href="#" class="text-decoration-none">
                                Forgot password?
                            </a>
                        </div>

                        <div class="mt-2">
                            Don't have an account?
                            <a href="#" class="text-info text-decoration-none">
                                Register here
                            </a>
                        </div>

                    </div>

                </div>

                <!-- Right Side -->
                <div class="col-lg-6 d-none d-lg-block p-0">
                    <img src="~/assets/img/image.jpg"
                         class="login-image"
                         alt="Login Image">
                </div>

            </div>
        </div>
    </section>
</form>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
