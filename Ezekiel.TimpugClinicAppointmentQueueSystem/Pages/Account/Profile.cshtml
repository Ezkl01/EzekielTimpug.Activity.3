@page "/account/profile"
@model Profile

<div class="container d-flex justify-content-center mt-5">
    <div class="card shadow p-4" style="max-width: 350px; width:100%;">
        <img src="@Model.UserDto.ProfileImage" class="card-img-top" alt="@Model.UserDto.FirstName @Model.UserDto.LastName">
        <div class="card-body">
        <h5 class="card-title">@Model.UserDto.FirstName @Model.UserDto.LastName</h5>
        <p class="card-text">@Model.UserDto.Username </p>
        <p class="card-text">@Model.UserDto.DateOfBirth?.ToString("D") </p>    
        <a href="/account/update-profile" class="btn btn-primary">Edit</a>
    </div>
</div>