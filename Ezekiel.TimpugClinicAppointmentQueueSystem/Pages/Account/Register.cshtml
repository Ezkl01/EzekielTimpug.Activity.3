@page "/account/register"
@model Register

@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Register";
}

<div class="mask d-flex align-items-center py-5 gradient-custom-3">
        <div class="container">
            <div class="row d-flex justify-content-center align-items-center">
                <div class="col-12 col-md-9 col-lg-7 col-xl-6">
                    <div class="card shadow" style="border-radius:15px;">
                        <div class="card-body p-4">
                            <h2 class="text-uppercase text-center mb-5">
                                Create an account
                            </h2>
                            <form method="post" class="mt-5">
                                <div class="mb-3">
                                    <label class="form-label">Email address</label>
                                    <input type="email"
                                           class="form-control"
                                           asp-for="@Model.UserRegisterDto.UserName">
                                    <span asp-validation-for="@Model.UserRegisterDto.UserName"
                                          class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Password</label>
                                    <input type="password"
                                           class="form-control"
                                           asp-for="@Model.UserRegisterDto.Password">
                                    <span asp-validation-for="@Model.UserRegisterDto.Password"
                                          class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Confirm Password</label>
                                    <input type="password"
                                           class="form-control"
                                           asp-for="@Model.UserRegisterDto.ConfirmPassword">
                                    <span asp-validation-for="@Model.UserRegisterDto.ConfirmPassword"
                                          class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">First Name</label>
                                    <input type="text"
                                           class="form-control"
                                           asp-for="@Model.UserRegisterDto.FirstName">
                                    <span asp-validation-for="@Model.UserRegisterDto.FirstName"
                                          class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Last Name</label>
                                    <input type="text"
                                           class="form-control"
                                           asp-for="@Model.UserRegisterDto.LastName">
                                    <span asp-validation-for="@Model.UserRegisterDto.LastName"
                                          class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Date of Birth</label>
                                    <input type="date"
                                           class="form-control"
                                           asp-for="@Model.UserRegisterDto.DateOfBirth">
                                    <span asp-validation-for="@Model.UserRegisterDto.DateOfBirth"
                                          class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <div asp-validation-summary="All" class="text-danger"></div>
                                </div>
                                <div class="d-flex justify-content-center">
                                    <button type="submit"
                                            class="btn btn-success btn-block btn-lg gradient-custom-4 text-body">
                                        Register
                                    </button>
                                </div>
                                <p class="text-center text-muted mt-2 mb-0">
                                    Have already an account?
                                    <a asp-page="/Account/Login"
                                       class="fw-bold text-info text-decoration-none">
                                        Login here
                                    </a>
                                </p>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

