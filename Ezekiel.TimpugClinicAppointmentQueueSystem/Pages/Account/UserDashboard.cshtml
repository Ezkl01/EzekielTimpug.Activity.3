@page "/user/dashboard"
@model UserDashboardModel

@{
    ViewData["Title"] = "User Dashboard";
}

<div class="user-dashboard">

    <!-- =========================
         SIDEBAR
    ========================== -->

    <aside class="user-sidebar">

        <div class="user-sidebar-brand">

            <div class="user-brand-icon">
                <i class="fas fa-solid fa-hospital"></i>
            </div>

            <div>
                <h2>ClinicCare</h2>
                <span>Appointment System</span>
            </div>

        </div>


        <nav class="user-sidebar-nav">

            <div class="user-nav-title">
                MAIN
            </div>

            <a href="/user/dashboard"
               class="user-nav-link active">

                <i class="fas fa-chart-pie"></i>

                <span>Dashboard</span>

            </a>


            <a href="/user/appointments"
               class="user-nav-link">

                <i class="fas fa-calendar-check"></i>

                <span>My Appointments</span>

            </a>
            <a href="/user/reports"
               class="user-nav-link">

                <i class="fas fa-file-medical"></i>
                <span>Report</span>

            </a>

            <div class="user-nav-title">
                ACCOUNT
            </div>


            <a href="/account/user-profile"
               class="user-nav-link">

                <i class="fas fa-user"></i>

                <span>Profile</span>

            </a>

            <button type="button"
                    class="user-nav-link"
                    id="openLogoutModal">

                <i class="fas fa-right-from-bracket"></i>

                <span>Logout</span>

            </button>

        </nav>


        <div class="user-sidebar-bottom">

            <div class="user-mini-profile">

                <div class="user-mini-avatar">
                    <i class="fas fa-user"></i>
                </div>

                <div>

                    <strong>
                        @User.Identity?.Name
                    </strong>

                    <span>
                        Patient
                    </span>

                </div>

            </div>

        </div>

    </aside>



    <!-- =========================
         MAIN
    ========================== -->

    <main class="user-main">


        <!-- TOPBAR -->

        <header class="user-topbar">

            <div class="user-topbar-left">

                <button type="button"
                        class="user-mobile-menu">

                    <i class="fas fa-bars"></i>

                </button>


                <div>

                    <span class="user-page-label">
                        PATIENT PORTAL
                    </span>

                    <h1>
                        Dashboard
                    </h1>

                </div>

            </div>


            <div class="user-topbar-right">

                <button type="button"
                        class="user-notification">

                    <i class="far fa-bell"></i>

                    <span></span>

                </button>


                <div class="user-profile-top">

                    <div class="user-top-avatar">
                        <i class="fas fa-user"></i>
                    </div>

                    <div>

                        <strong>
                            @User.Identity?.Name
                        </strong>

                        <span>
                            Patient
                        </span>

                    </div>

                </div>

            </div>

        </header>



        <!-- =========================
             CONTENT
        ========================== -->

        <div class="user-dashboard-content">


            <!-- WELCOME -->

            <section class="user-welcome">

                <div class="user-welcome-content">

                    <span class="user-welcome-badge">

                        <i class="fas fa-heart-pulse"></i>

                        PATIENT PORTAL

                    </span>


                    <h2>
                        Welcome back!
                    </h2>


                    <p>
                        Manage your appointments, find available doctors,
                        and keep track of your healthcare in one place.
                    </p>


                    <div class="user-welcome-actions">

                        <a href="/appointments"
                           class="user-primary-button">

                            <i class="fas fa-calendar-plus"></i>

                            Book Appointment

                        </a>


                        <a href="/doctors"
                           class="user-outline-button">

                            <i class="fas fa-user-doctor"></i>

                            Find a Doctor

                        </a>

                    </div>

                </div>


                <div class="user-welcome-decoration">

                    <div class="user-circle user-circle-one"></div>

                    <div class="user-circle user-circle-two"></div>

                    <i class="fas fa-heart-pulse"></i>

                </div>

            </section>



            <!-- =========================
                 STATISTICS
            ========================== -->

            <section class="user-stat-grid">


                <!-- TOTAL APPOINTMENTS -->

                <div class="user-stat-card">

                    <div class="user-stat-top">

                        <div class="user-stat-icon blue">
                            <i class="fas fa-calendar-check"></i>
                        </div>

                        <span class="user-stat-label">
                            TOTAL
                        </span>

                    </div>


                    <div class="user-stat-info">

                        <span>
                            Clinic Appointments
                        </span>

                        <strong>
                            @Model.TotalAppointments
                        </strong>

                    </div>


                    <small>
                        All of Clinic appointments
                    </small>

                </div>



                <!-- PENDING -->

                <div class="user-stat-card">

                    <div class="user-stat-top">

                        <div class="user-stat-icon orange">
                            <i class="fas fa-clock"></i>
                        </div>

                        <span class="user-stat-label pending">
                            WAITING
                        </span>

                    </div>


                    <div class="user-stat-info">

                        <span>
                            Pending
                        </span>

                        <strong>
                            @Model.TotalPendingAppointments
                        </strong>

                    </div>


                    <small>
                        Awaiting confirmation
                    </small>

                </div>



                <!-- CONFIRMED -->

                <div class="user-stat-card">

                    <div class="user-stat-top">

                        <div class="user-stat-icon green">
                            <i class="fas fa-circle-check"></i>
                        </div>

                        <span class="user-stat-label">
                            CONFIRMED
                        </span>

                    </div>


                    <div class="user-stat-info">

                        <span>
                            Confirmed
                        </span>

                        <strong>
                            @Model.TotalConfirmedAppointments
                        </strong>

                    </div>


                    <small>
                        Confirmed appointments
                    </small>

                </div>



                <!-- AVAILABLE DOCTORS -->

                <div class="user-stat-card">

                    <div class="user-stat-top">

                        <div class="user-stat-icon purple">
                            <i class="fas fa-user-doctor"></i>
                        </div>

                        <span class="user-stat-label">
                            CLINIC
                        </span>

                    </div>


                    <div class="user-stat-info">

                        <span>
                            Available Doctors
                        </span>

                        <strong>
                            @Model.TotalDoctors
                        </strong>

                    </div>


                    <small>
                        Doctors available
                    </small>

                </div>

            </section>

            <!-- =========================
                 RECENT APPOINTMENTS
            ========================== -->

            <section class="user-card recent-card">

                <div class="user-card-header">

                    <div>

                        <span>
                            HISTORY
                        </span>

                        <h3>
                            Recent Appointments
                        </h3>

                    </div>


                    <a href="/user/appointments">

                        View all

                        <i class="fas fa-arrow-right"></i>

                    </a>

                </div>


                <div class="recent-empty">

                    <div>

                        <i class="fas fa-calendar-xmark"></i>

                    </div>

                    <h4>
                        Your appointments will appear here
                    </h4>

                    <p>
                        Once you make an appointment,
                        your recent visits will be shown here.
                    </p>

                    <a href="/appointments"
                       class="recent-book-button">

                        <i class="fas fa-calendar-plus"></i>

                        Book your first appointment

                    </a>

                </div>

            </section>



            <!-- =========================
                 LOGOUT MODAL
            ========================== -->

            <div class="logout-modal-overlay"
                 id="logoutModal">

                <div class="logout-modal-box">

                    <div class="logout-modal-icon">

                        <i class="fas fa-sign-out-alt"></i>

                    </div>

                    <h2>
                        Log out?
                    </h2>

                    <p>
                        Are you sure you want to log out of your account?
                    </p>

                    <div class="logout-modal-actions">

                        <button type="button"
                                class="logout-cancel-btn"
                                id="closeLogoutModal">

                            Cancel

                        </button>

                        <form method="post"
                              asp-page="/Account/Logout">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="logout-confirm-btn">

                                <i class="fas fa-sign-out-alt"></i>

                                Yes, Log Out

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </main>

</div>



@section Scripts {

    <script>

        // ==========================================
        // LOGOUT MODAL
        // ==========================================

        const openLogoutModal =
            document.getElementById("openLogoutModal");

        const closeLogoutModal =
            document.getElementById("closeLogoutModal");

        const logoutModal =
            document.getElementById("logoutModal");


        if (openLogoutModal && logoutModal) {

            openLogoutModal.addEventListener("click", function () {

                logoutModal.classList.add("show");

            });

        }


        if (closeLogoutModal && logoutModal) {

            closeLogoutModal.addEventListener("click", function () {

                logoutModal.classList.remove("show");

            });

        }


        if (logoutModal) {

            logoutModal.addEventListener("click", function (event) {

                if (event.target === logoutModal) {

                    logoutModal.classList.remove("show");

                }

            });

        }


        // ==========================================
        // MOBILE SIDEBAR
        // ==========================================

        document.addEventListener("DOMContentLoaded", function () {

            const menuButton =
                document.querySelector(".user-mobile-menu");

            const sidebar =
                document.querySelector(".user-sidebar");


            if (menuButton && sidebar) {

                menuButton.addEventListener("click", function () {

                    sidebar.classList.toggle(
                        "user-sidebar-open"
                    );

                });

            }

        });

    </script>

}