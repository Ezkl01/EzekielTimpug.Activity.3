@page "/account/verify-forgot-password"
@model VerifyForgotPassword

<form method="post" class="mt-5">
    <div class="container">
        <div class="row justify-content-center">

            <div class="col-lg-5">

                <div class="card shadow" style="border-radius:15px;">

                    <div class="card-body p-5">
<div asp-validation-summary="All" class="text-danger mb-3"> </div>
                        <!-- Information -->
                        <div class="mb-3" style="width:400px;">
                            <span class="text-info">
                                Please enter a new password for your account.
                            </span>
                        </div>

                        <!-- Hidden User ID -->
                        <input type="hidden"
                               id="exampleInputUserId1"
                               asp-for="@Model.VerifyForgotPasswordDto!.UserId">

                        <!-- Password -->
                        <div class="mb-3" style="width:400px;">
                            <label for="exampleInputPassword1"
                                   class="form-label">
                                Password
                            </label>

                            <input type="password"
                                   class="form-control"
                                   id="exampleInputPassword1"
                                   asp-for="@Model.VerifyForgotPasswordDto!.Password">

                            <span asp-validation-for="@Model.VerifyForgotPasswordDto!.Password"
                                  class="text-danger"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-3" style="width:400px;">
                            <label for="exampleInputConfirmPassword1"
                                   class="form-label">
                                Confirm Password
                            </label>

                            <input type="password"
                                   class="form-control"
                                   id="exampleInputConfirmPassword1"
                                   asp-for="@Model.VerifyForgotPasswordDto!.ConfirmPassword">

                            <span asp-validation-for="@Model.VerifyForgotPasswordDto!.ConfirmPassword"
                                  class="text-danger"></span>
                        </div>

                        <!-- Button -->
                        <div class="d-flex justify-content-end"
                             style="width:400px;">

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Submit
                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>
</form>